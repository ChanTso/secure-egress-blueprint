# This file is intentionally non-deploying and uses documentation-only values.
deployment_enabled = false

aws_region       = "us-east-2"
availability_zone = "us-east-2a"
name_prefix      = "synthetic-egress"

tls_source_cidrs = ["198.51.100.0/24"]
