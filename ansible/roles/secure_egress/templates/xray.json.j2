{% set secure_egress_protected_destinations = [
  "0.0.0.0/8",
  "10.0.0.0/8",
  "100.64.0.0/10",
  "127.0.0.0/8",
  "169.254.0.0/16",
  "172.16.0.0/12",
  "192.0.0.0/24",
  "192.0.2.0/24",
  "192.88.99.0/24",
  "192.168.0.0/16",
  "198.18.0.0/15",
  "198.51.100.0/24",
  "203.0.113.0/24",
  "224.0.0.0/4",
  "240.0.0.0/4",
  "::/128",
  "::1/128",
  "::ffff:0:0/96",
  "64:ff9b::/96",
  "64:ff9b:1::/48",
  "100::/64",
  "2001::/32",
  "2001:2::/48",
  "2001:10::/28",
  "2001:20::/28",
  "2001:db8::/32",
  "2002::/16",
  "3fff::/20",
  "fc00::/7",
  "fec0::/10",
  "fe80::/10",
  "ff00::/8"
] %}
{
  "version": {
    "min": "26.5.3",
    "max": ""
  },
  "log": {
    "loglevel": "warning"
  },
  "api": {
    "tag": "api",
    "services": [
      "StatsService"
    ]
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  },
  "inbounds": [
    {
      "tag": "tunnel",
      "listen": "127.0.0.1",
      "port": {{ secure_egress_xray_tunnel_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": {{ secure_egress_client_id | to_json }},
            "level": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": {{ secure_egress_tunnel_path | to_json }}
        }
      }
    },
    {
      "tag": "api",
      "listen": "127.0.0.1",
      "port": {{ secure_egress_xray_stats_port }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "blocked",
      "protocol": "blackhole"
    },
    {
      "tag": "egress",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP",
        "finalRules": [
          {
            "action": "block",
            "network": "tcp,udp",
            "ip": {{ secure_egress_protected_destinations | to_json }}
          }
        ]
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "inboundTag": [
          "tunnel"
        ],
        "ip": {{ secure_egress_protected_destinations | to_json }},
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "inboundTag": [
          "tunnel"
        ],
        "network": "tcp,udp",
        "outboundTag": "egress"
      }
    ]
  }
}
