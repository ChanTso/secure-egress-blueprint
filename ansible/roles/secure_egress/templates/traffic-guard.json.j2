    {% if secure_egress_traffic_guard_auto_stop_enabled %}true{% else %}false{% endif %},
  "stop_acknowledgement": {{ secure_egress_traffic_guard_stop_acknowledgement | to_json }},
  "xray_binary": {{ secure_egress_xray_binary | to_json }},
