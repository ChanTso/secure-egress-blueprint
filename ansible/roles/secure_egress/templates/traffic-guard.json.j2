  "counter_prefix": {{ secure_egress_traffic_guard_counter_prefix | to_json }},
  "state_path": {{ (secure_egress_state_root + "/traffic-guard.json") | to_json }},
  "service_name": "secure-egress-xray.service",
  "query_user": "xray"
}
